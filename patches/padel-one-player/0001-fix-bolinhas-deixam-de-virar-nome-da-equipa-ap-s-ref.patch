A Edge Function sobrescrevia recentMatches com fallbacks do label da
equipa. Mantém nomes de pessoa do fetch inicial e trata igualdade com
team_name como label (nunca bolinha).
---
 src/lib/matchPlayerNames.ts    | 12 +++-------
 src/lib/playerDashboardData.ts | 41 +++++++++++++++++++++++++++++++---
 2 files changed, 41 insertions(+), 12 deletions(-)

diff --git a/src/lib/matchPlayerNames.ts b/src/lib/matchPlayerNames.ts
index 149c32b..e7ca83d 100644
--- a/src/lib/matchPlayerNames.ts
+++ b/src/lib/matchPlayerNames.ts
@@ -8,20 +8,14 @@ export function isLikelyTeamLabel(name: string | null | undefined, teamName?: st
   const n = name.trim()
   if (!n || n === '?' || n === 'TBD') return true
   if (/^jogador\s*\d*$/i.test(n) || /^player\s*\d*$/i.test(n)) return true
+  // Exact match to the team name → never show team label inside a player bubble
+  if (teamName && n.toLowerCase() === teamName.trim().toLowerCase()) return true
   // Very short all-caps / acronyms used as team codes (RP, FM, AB)
   if (/^[A-ZÁÉÍÓÚ]{1,3}$/.test(n)) return true
   // Company-style / generic team names
   if (/\b(lda|ltd|sa|team|equipa)\b/i.test(n)) return true
-  // Explicit pair separators with spaces: "Ana / Pedro"
+  // Explicit pair separators: "Ana / Pedro", "Ana & Pedro", "Ana - Pedro"
   if (/\s\/\s|\s&\s|,\s|\s-\s/.test(n)) return true
-  // Exact match to team name only when that name itself looks like a team label
-  if (teamName && n.toLowerCase() === teamName.trim().toLowerCase()) {
-    const t = teamName.trim()
-    if (/^[A-ZÁÉÍÓÚ]{1,3}$/.test(t)) return true
-    if (/\s\/\s|\s&\s|,\s|\s-\s/.test(t)) return true
-    // "Dinis-Carlos" style team codes
-    if (/^[A-ZÀ-Ú][A-Za-zÀ-ú']+-[A-ZÀ-Ú][A-Za-zÀ-ú']+$/.test(t)) return true
-  }
   return false
 }
 
diff --git a/src/lib/playerDashboardData.ts b/src/lib/playerDashboardData.ts
index 73da626..d21016f 100644
--- a/src/lib/playerDashboardData.ts
+++ b/src/lib/playerDashboardData.ts
@@ -3,6 +3,7 @@
  * Lê da mesma base Supabase; os dados ficam nos dois lados (Tour e Player).
  */
 import { supabase } from './supabase'
+import { isLikelyTeamLabel } from './matchPlayerNames'
 
 export interface TournamentSummary {
   id: string
@@ -797,16 +798,50 @@ export async function enrichDashboardWithEdgeFunction(currentDashboardData?: Pla
     if (edgeData.recentMatches?.length) {
       // Check if Edge Function already includes open games
       const edgeOpenGames = edgeData.recentMatches.filter((m: any) => m.is_open_game)
-      
+
+      const clientById = new Map(
+        (currentDashboardData?.recentMatches || []).map((m) => [m.id, m]),
+      )
+
+      const preferPersonName = (
+        edgeName: string | undefined,
+        clientName: string | undefined,
+        teamName?: string | null,
+      ): string | undefined => {
+        const edgeOk = edgeName && !isLikelyTeamLabel(edgeName, teamName)
+        const clientOk = clientName && !isLikelyTeamLabel(clientName, teamName)
+        if (edgeOk) return edgeName
+        if (clientOk) return clientName
+        return edgeName || clientName
+      }
+
+      const mergeMatchNames = (edgeMatch: any) => {
+        const clientMatch = clientById.get(edgeMatch.id)
+        if (!clientMatch) return edgeMatch
+        return {
+          ...edgeMatch,
+          player1_name: preferPersonName(edgeMatch.player1_name, clientMatch.player1_name, edgeMatch.team1_name),
+          player2_name: preferPersonName(edgeMatch.player2_name, clientMatch.player2_name, edgeMatch.team1_name),
+          player3_name: preferPersonName(edgeMatch.player3_name, clientMatch.player3_name, edgeMatch.team2_name),
+          player4_name: preferPersonName(edgeMatch.player4_name, clientMatch.player4_name, edgeMatch.team2_name),
+          player1_avatar: edgeMatch.player1_avatar || clientMatch.player1_avatar,
+          player2_avatar: edgeMatch.player2_avatar || clientMatch.player2_avatar,
+          player3_avatar: edgeMatch.player3_avatar || clientMatch.player3_avatar,
+          player4_avatar: edgeMatch.player4_avatar || clientMatch.player4_avatar,
+          my_side: edgeMatch.my_side ?? clientMatch.my_side,
+        }
+      }
+
       if (edgeOpenGames.length > 0) {
-        // Edge Function v2+ already includes open games - use directly
+        // Edge Function v2+ already includes open games - merge names with better client data
         enriched.recentMatches = edgeData.recentMatches
+          .map(mergeMatchNames)
           .sort((a: any, b: any) => new Date(b.start_time).getTime() - new Date(a.start_time).getTime())
         console.log('[Dashboard] Edge Function recentMatches (includes open games):', edgeData.recentMatches.length, '(', edgeOpenGames.length, 'open games)')
       } else {
         // Edge Function v1 - merge with client-side open games
         const currentOpenGames = (currentDashboardData?.recentMatches || []).filter(m => m.is_open_game)
-        const allMatches = [...edgeData.recentMatches, ...currentOpenGames]
+        const allMatches = [...edgeData.recentMatches.map(mergeMatchNames), ...currentOpenGames]
           .sort((a, b) => new Date(b.start_time).getTime() - new Date(a.start_time).getTime())
         enriched.recentMatches = allMatches
         console.log('[Dashboard] Edge Function recentMatches:', edgeData.recentMatches.length, '+ open games:', currentOpenGames.length, '= total:', allMatches.length)
